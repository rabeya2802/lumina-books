# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=online_book_store

# JWT secret (set a long random string in production)
JWT_SECRET=your_jwt_secret_key

# Gmail SMTP (for email verification & password reset)
# See README for how to create a Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your@email.com

# Optional legacy fallback names (also supported)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your@email.com

# Comma-separated list of allowed frontend origins for CORS.
# In production, set this to your Vercel URL, e.g.
#   https://lumina-books.vercel.app
# Multiple origins allowed: https://site1.vercel.app,https://site2.vercel.app
CORS_ORIGIN=

# Set to "production" to disable dev OTP/code fallbacks
NODE_ENV=development
