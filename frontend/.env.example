# Frontend environment variables (Vite)
# Copy to .env and adjust as needed.
#
# In DEVELOPMENT: leave empty to use the Vite dev proxy (/api -> localhost:5001).
# In PRODUCTION (Vercel): set this to your backend URL, e.g.
#   VITE_API_URL=https://api.yourdomain.com
# or, if no domain, the VM IP + port, e.g.
#   VITE_API_URL=http://XX.XX.XX.XX:5000
VITE_API_URL=